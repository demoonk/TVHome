<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- One permission: talk to adbd on loopback. The app does not run at boot any more, so the boot broadcast is
         not asked for: the single job happens when Home's settings row sends the action below, or when the app is
         opened. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application android:allowBackup="false" android:label="@string/app_name" android:banner="@drawable/banner">

        <!-- One launchable screen: it shows the result of the single job, so the owner can see what adbd answered
             without opening logcat. -->
        <activity
            android:name=".EnsureActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Answers the action the settings row in Home («Система» → «Запросить загрузку сейчас») sends on a press:
             one connect to adbd as an ADB client, where the command runs as uid 2000 shell. goAsync() with a bounded
             timeout in EnsureReceiver, no foreground service, no boot filter. -->
        <receiver
            android:name=".EnsureReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.github.sumyabazar1.bridgehelper.action.ENSURE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
