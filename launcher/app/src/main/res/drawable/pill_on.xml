<?xml version="1.0" encoding="utf-8"?>
<!-- A VPN button while its tunnel is up: the pill turns light and the monochrome mark goes dark, the
     inverse of its idle look. Focused or not, the same plate, so the state reads at a glance. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F2FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>
