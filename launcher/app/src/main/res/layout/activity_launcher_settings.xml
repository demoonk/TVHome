<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101419"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="72dp"
        android:paddingEnd="72dp"
        android:paddingTop="38dp"
        android:paddingBottom="38dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/launcher_settings"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/reorderChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="28dp"
            android:text="@string/reorder"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/columns_label"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/columns4" style="@style/SettingsColumnChoice" android:text="4" />
            <TextView android:id="@+id/columns5" style="@style/SettingsColumnChoice" android:text="5" />
            <TextView android:id="@+id/columns6" style="@style/SettingsColumnChoice" android:text="6" />
            <TextView android:id="@+id/columns7" style="@style/SettingsColumnChoice" android:text="7" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/rows_below_dock_label"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            
            <TextView android:id="@+id/rows1" style="@style/SettingsColumnChoice" android:text="1" />
            <TextView android:id="@+id/rows2" style="@style/SettingsColumnChoice" android:text="2" />
            <TextView android:id="@+id/rows3" style="@style/SettingsColumnChoice" android:text="3" />
        </LinearLayout>

        

        

        <TextView
            android:id="@+id/wallpaperChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="28dp" />

        <TextView
            android:id="@+id/animationsChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="28dp" />

        

        

        <TextView
            android:id="@+id/dimDelayChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="28dp" />

        <TextView
            android:id="@+id/dimRampChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/weatherCityChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="18dp" />

        <TextView
            android:id="@+id/weatherGpsChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp"
            android:text="@string/weather_gps" />

        

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="@string/follow_theme_hint"
            android:textColor="#FFACB8C1"
            android:textSize="14sp" />

        

        

        <TextView
            android:id="@+id/clockColorChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="18dp"
            android:text="@string/clock_color" />

        <TextView
            android:id="@+id/clockCornerChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp"
            android:text="@string/clock_corner" />

        <TextView
            android:id="@+id/clockSizeChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp"
            android:text="@string/clock_size" />
        <TextView
            android:id="@+id/clockFontChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp"
            android:text="@string/clock_font" />
        

        

        <TextView
            android:id="@+id/oledShiftChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="18dp"
            android:text="@string/oled_shift" />

        <TextView android:id="@+id/tileCropChoice" style="@style/SettingsRow" android:layout_marginTop="18dp" android:text="Обрезка изображений плиток" />
        <TextView android:id="@+id/headerPlateChoice" style="@style/SettingsRow" android:layout_marginTop="18dp" android:text="Плашки шапки" />
        <TextView android:id="@+id/plateOpacityChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" android:text="Непрозрачность плашек" />
        <TextView android:id="@+id/plateBlurChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" android:text="Мягкость плашек" />
        <TextView
            android:id="@+id/clockPositionChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp"
            android:text="@string/clock_position" />

        <TextView
            android:id="@+id/assistantChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="18dp"
            android:text="@string/voice_assistant" />
        <TextView android:id="@+id/microphoneChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" android:text="Микрофон" />
        <TextView android:id="@+id/sleepSettingsChoice" style="@style/SettingsRow" android:layout_marginTop="18dp" android:text="Время до сна" />

        <TextView
            android:id="@+id/tvSettingsChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="18dp"
            android:text="@string/tv_settings" />
    </LinearLayout>
</ScrollView>
